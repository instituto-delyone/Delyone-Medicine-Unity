{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "medunity-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "medunity-auth"
    }
  ]
}
